{{- /* A TEMPLATE only for djinn.serverUrl, a secret (the Djinn server's host) rendered by sops in
       modules/dms-djinn.nix; everything else is the plain DMS snapshot. Capture with care: `chezmoi
       re-add` SKIPS templates and `chezmoi add` offers to de-template (answer no), so after DMS
       changes something, copy the change into this file by hand and keep the serverUrl line as is. */ -}}
{
  "hyprlandSubmapIndicator": {
    "enabled": true,
    "clickToReset": true,
    "defaultIconName": "key"
  },
  "linuxWallpaperEngine": {
    "enabled": true,
    "monitorPlaylists": {},
    "monitorScenes": {
      "DP-1": "897016354",
      "DP-2": "897016354",
      "DP-4": "897016354",
      "DP-5": "897016354",
      "DP-6": "897016354",
      "DP-3": "897016354"
    },
    "sceneSettings": {
      "897016354": {
        "noAudioProcessing": true,
        "fps": 60,
        "scaling": "fill"
      }
    },
    "playlistIntervalMinutes": 10,
    "generateStaticWallpaper": true,
    "namedPlaylists": {
      "Default": []
    }
  },
  "dankKDEConnect": {
    "enabled": true
  },
  "dankNotepadModule": {
    "enabled": true
  },
  "networkIndicator": {
    "enabled": true,
    "interfaceGroups": [
      {
        "name": "LAN",
        "pattern": "en.*"
      },
      {
        "name": "Docker",
        "pattern": "(docker|br-|veth).*"
      }
    ],
    "perAppTraffic": true
  },
  "dockerManager": {
    "enabled": true,
    "groupByCompose": false
  },
  "dankUpsMonitor": {
    "enabled": true,
    "mainsBarStatistic": "load",
    "upsDevice": "cyberpower@localhost"
  },
  "djinn": {
    "enabled": true,
    "serverUrl": {{ $u := "/run/secrets/rendered/djinn-server-url" }}{{ if stat $u }}{{ include $u | trim | toJson }}{{ else }}""{{ end }},
    "width": 960,
    "slideDuration": 200,
    "awayMinutes": 1
  }
}