#!/usr/bin/env bash
# Sync yazi plugins from the package.toml lockfile (chezmoi-managed). The embedded
# hash below makes chezmoi re-run this whenever the lockfile changes; `after_` so
# the freshly-applied package.toml is what `ya pkg install` reads.
# package.toml hash: {{ include "dot_config/yazi/package.toml" | sha256sum }}
set -eu
if ! command -v ya >/dev/null 2>&1; then
  # Fresh box where nixos-rebuild hasn't landed yazi yet — don't fail the whole
  # apply; plugins can be synced later with a manual `ya pkg install`.
  echo "yazi plugins: 'ya' not on PATH yet — skipping (run 'ya pkg install' after rebuild)" >&2
  exit 0
fi
ya pkg install
