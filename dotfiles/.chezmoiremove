# Hyprland 0.55+ generates a default hyprland.lua, and a .lua config takes
# PRECEDENCE over our hyprland.conf — silently hijacking the whole config
# (no DMS/autostart, defaults everywhere). Nuke any stray copy on every apply.
.config/hypr/hyprland.lua

# Retired: screenshots now go straight through `flameshot gui` (PrintScreen) with the wrapped grim
# portal + render:keep_unmodified_copy=0 for HDR. Drop the old SDR-flip wrapper from any machine.
.config/hypr/screenshot-hdr.sh

# nvim moved from the stub init.vim to a LazyVim init.lua. Neovim errors when both
# init.vim and init.lua exist, so evict the old stub from every machine that had it.
.config/nvim/init.vim

# zsh retired (2026-07 go-public scrub) — fish is the only maintained shell, and the zsh
# files carried stale employer config. Evict the previously-managed copies everywhere.
.zshrc
.zshaliases
.zshrc.d/**
.zshrc.d

# 2026-07-12: a committed editor backup, byte-identical to fish_frozen_key_bindings.fish. Never
# read (fish auto-loads conf.d/*.fish, not *.fish.bak) but it WAS deployed, so deleting the source
# alone would leave it orphaned in ~ forever.
.config/fish/conf.d/fish_frozen_key_bindings.fish.bak

# 2026-09-16: fishconfig.d/ retired — its contents moved to fish's native conf.d/ (eager: aliases,
# per-OS env, secrets, tool hooks), functions/ (autoloaded) and completions/. Evict the previously
# managed targets, INCLUDING the decrypted secrets.fish plaintext. Files only, never the directory:
# work boxes keep an unmanaged os_confs.d/amazon_linux.fish in there that must not be nuked (move
# it to conf.d/ by hand — nothing sources it any more; the empty dirs can just be rmdir'd).
.config/fish/fishconfig.d/secrets.fish
.config/fish/fishconfig.d/fish_aliases.fish
.config/fish/fishconfig.d/fish_functions.fish
.config/fish/fishconfig.d/claude-edge.fish
.config/fish/fishconfig.d/mise.fish
.config/fish/fishconfig.d/os_confs.d/linux.fish
.config/fish/fishconfig.d/os_confs.d/linux-wsl.fish
.config/fish/fishconfig.d/os_confs.d/osx.fish
.config/fish/fishconfig.d/os_confs.d/bsd.fish
.config/fish/fishconfig.d/os_confs.d/centos.fish
